# Copy this file to .env and fill in real values. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=population_app
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DB_DATABASE=williamdb
PORT=3000

# Comma-separated list of origins allowed to call the API with credentials.
FRONTEND_ORIGIN=http://localhost:3001

# Enable TLS for the MySQL connection (set to true in production).
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Required. Must be at least 32 characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=24h

# Required. App-level pepper appended to every password before bcrypt.
# Generate the same way as JWT_SECRET. Never change it without a migration.
PASSWORD_PEPPER=REPLACE_WITH_A_LONG_RANDOM_PEPPER

# Force Secure cookies when running behind HTTPS (production sets this
# automatically when NODE_ENV=production).
COOKIE_SECURE=false

# Name shown in authenticator apps.
TWO_FACTOR_ISSUER=AHIES Population Survey
